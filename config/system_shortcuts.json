  "queries": [
    {
      "id": "bluetooth_devices",
      "name": "Bluetooth devices",
      "aliases": ["bluetooth devices", "paired bluetooth devices", "check bluetooth devices", "list bluetooth devices", "what bluetooth devices"],
      "shell": "powershell",
      "command": "Get-PnpDevice -Class Bluetooth -ErrorAction SilentlyContinue | Where-Object { $_.Present -eq $true } | Select-Object FriendlyName,Status | ConvertTo-Json -Compress",
      "empty_message": "no Bluetooth devices were found (radio may be off, or nothing is paired)"
    },
    {
      "id": "wifi_networks",
      "name": "Nearby Wi-Fi networks",
      "aliases": ["wifi networks", "nearby wifi networks", "available wifi networks", "list wifi networks", "scan wifi"],
      "shell": "netsh",
      "command": "netsh wlan show networks",
      "parser": "netsh_networks",
      "empty_message": "no Wi-Fi networks were found (adapter may be off)"
    },
    {
      "id": "wifi_current",
      "name": "Current Wi-Fi connection",
      "aliases": ["current wifi", "wifi status", "what network am i connected to", "connected wifi", "wifi connection status"],
      "shell": "netsh",
      "command": "netsh wlan show interfaces",
      "parser": "netsh_interface",
      "empty_message": "no active Wi-Fi connection was found"
    },
    {
      "id": "battery_status",
      "name": "Battery status",
      "aliases": ["battery status", "battery percentage", "how much battery", "battery level", "check battery"],
      "shell": "powershell",
      "command": "Get-CimInstance Win32_Battery -ErrorAction SilentlyContinue | Select-Object EstimatedChargeRemaining,BatteryStatus | ConvertTo-Json -Compress",
      "empty_message": "no battery was found (this may be a desktop with no battery)"
    },
    {
      "id": "disk_usage",
      "name": "Disk / storage usage",
      "aliases": ["disk space", "storage space", "how much storage", "free disk space", "disk usage", "how much space left"],
      "shell": "powershell",
      "command": "Get-PSDrive -PSProvider FileSystem -ErrorAction SilentlyContinue | Select-Object Name,@{n='UsedGB';e={[math]::Round($_.Used/1GB,1)}},@{n='FreeGB';e={[math]::Round($_.Free/1GB,1)}} | ConvertTo-Json -Compress",
      "empty_message": "no drives could be read"
    },
    {
      "id": "network_info",
      "name": "Network / IP configuration",
      "aliases": ["ip address", "network info", "my ip address", "network configuration", "what's my ip"],
      "shell": "powershell",
      "command": "Get-NetIPConfiguration -ErrorAction SilentlyContinue | Select-Object InterfaceAlias,@{n='IPv4';e={$_.IPv4Address.IPAddress}} | ConvertTo-Json -Compress",
      "empty_message": "no active network interfaces were found"
    },
    {
      "id": "system_info",
      "name": "System / OS info",
      "aliases": ["system info", "windows version", "os version", "computer info", "what windows version"],
      "shell": "powershell",
      "command": "Get-CimInstance Win32_OperatingSystem -ErrorAction SilentlyContinue | Select-Object Caption,Version,LastBootUpTime | ConvertTo-Json -Compress",
      "empty_message": "system info could not be read"
    },
    {
      "id": "running_processes",
      "name": "Top running processes",
      "aliases": ["running processes", "top processes", "what's using cpu", "cpu usage", "what's running"],
      "shell": "powershell",
      "command": "Get-Process -ErrorAction SilentlyContinue | Sort-Object CPU -Descending | Select-Object -First 6 Name,@{n='CPU';e={[math]::Round($_.CPU,1)}} | ConvertTo-Json -Compress",
      "empty_message": "no process list could be read"
    },
    {
      "id": "installed_apps",
      "name": "Installed applications",
      "aliases": ["installed apps", "installed programs", "what apps are installed", "list installed programs", "what's installed"],
      "shell": "powershell",
      "command": "Get-ItemProperty 'HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*','HKLM:\\Software\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*' -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName } | Select-Object -First 25 -ExpandProperty DisplayName | ConvertTo-Json -Compress",
      "empty_message": "no installed applications could be read"
    },
    {
      "id": "printers_list",
      "name": "Printers",
      "aliases": ["printers", "list printers", "what printers", "available printers", "check printers"],
      "shell": "powershell",
      "command": "Get-Printer -ErrorAction SilentlyContinue | Select-Object Name,PrinterStatus | ConvertTo-Json -Compress",
      "empty_message": "no printers were found"
    },
    {
      "id": "firewall_status",
      "name": "Firewall status",
      "aliases": ["firewall status", "is firewall on", "firewall settings status", "check firewall"],
      "shell": "powershell",
      "command": "Get-NetFirewallProfile -ErrorAction SilentlyContinue | Select-Object Name,Enabled | ConvertTo-Json -Compress",
      "empty_message": "firewall status could not be read"
    }
  ]
}
