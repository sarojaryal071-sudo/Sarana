# .env.example — backend environment variables, root of the repo.
#
# This is a TEMPLATE only. Copy to `.env` for local use if you want to test
# the environment-variable paths locally (see DEPLOYMENT.md for whether you
# even need to — desktop/local development normally doesn't). Never commit
# a real `.env` — the root .gitignore already excludes it.
#
# This list was built by auditing the actual codebase for every
# os.environ.get(...)/os.getenv(...) call that is genuinely a deployment
# knob (not the many OS-path-detection env vars actions/*.py reads for
# desktop features — APPDATA, XDG_*, PROGRAMFILES, etc. — those aren't
# something you configure, they're already set by the OS). Exactly three
# variables qualify. Nothing here is invented.

# ── Required for the Gemini connection to work at all ───────────────────
# Read by main.py's _get_api_key(). Takes priority over the existing
# config/api_keys.json fallback (which desktop/local development keeps
# using unmodified when this is unset) — see main.py for the exact
# lookup order. Never commit a real value.
GEMINI_API_KEY=enter_your_gemini_api_key_here

# ── Optional — has a working default ─────────────────────────────────────
# Read by dashboard/server.py. Render supplies this automatically; you do
# not need to set it there. Only relevant if you want the backend to
# listen on a non-default port locally. Defaults to 8000 when unset.
PORT=8000

# Read by dashboard/server.py's _cors_allowed_origins(). Comma-separated
# list, ADDED to the built-in localhost dev origins (5173/3000) — you do
# not need to repeat those here. Only needed once a frontend is deployed
# somewhere other than localhost (e.g. Vercel) and needs to call the
# REST routes. Leave unset for pure local development.
SARANA_ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app

# Read by memory/postgres_repo.py's is_configured(). Optional — unset
# means SARANA's personal/shared memory falls back to the local
# memory/long_term.json file, exactly as before this feature existed.
# Set to a real PostgreSQL connection string (e.g. a Neon or Render
# managed Postgres database) to get durable, per-user memory. Never
# commit a real value.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Optional — enables Google Calendar integration (web) ─────────────────
# Read by actions/calendar_auth.py's is_configured() and
# dashboard/server.py's /auth/google routes. All three are required
# together for Calendar to be available at all; unset means SARANA simply
# never offers Calendar connection (get_calendar_events/create_calendar_
# event/etc. honestly report [CALENDAR_NOT_CONNECTED] instead). Also
# requires DATABASE_URL above (Calendar credentials are stored encrypted
# in Postgres — see actions/calendar_store.py — never in
# memory/long_term.json, never in browser storage). Create these in the
# Google Cloud Console (OAuth consent screen + a Web application OAuth
# client) — never commit real values.
GOOGLE_CLIENT_ID=enter_your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=enter_your_google_oauth_client_secret_here
# Must exactly match a redirect URI registered on that same OAuth client
# in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://sarana-m9g6.onrender.com/auth/google/callback
