# frontend/.env.example — Vite environment variables.
#
# Copy to .env.local for local development (frontend/.gitignore already
# excludes .env.local — never commit a real one).
#
# IMPORTANT: every VITE_* variable is bundled directly into the shipped
# JavaScript and is visible to anyone who opens the site — never put a
# secret (Gemini key, etc.) in a variable prefixed VITE_. This project's
# only frontend variable is a plain URL, which is fine to expose.
#
# Audited against frontend/src/lib/api.js, websocket.js, audioOut.js, and
# mic.js: exactly one variable is read anywhere in the frontend. There is
# no separate WebSocket URL variable — websocket.js/audioOut.js/mic.js all
# derive wss:// from this same URL automatically (see api.js's
# wsBaseUrl()), so you only ever set this one value.

# ── Required ───────────────────────────────────────────────────────────
# Base URL of the running Sarana backend (dashboard/server.py). No
# trailing slash. https:// automatically derives wss:// for WebSocket
# connections; http:// derives ws://.
#
# Local development (backend running as `python server_main.py` with no
# SSL certs configured — the common case):
VITE_JARVIS_BACKEND_URL=http://localhost:8000
#
# Local development, if your backend has config/certs/ configured (see
# dashboard/server.py's _ssl_enabled()) and serves https/wss instead:
# VITE_JARVIS_BACKEND_URL=https://127.0.0.1:8000
#
# Production (Vercel): set this in Vercel's Environment Variables to your
# deployed Render backend's URL, e.g.:
# VITE_JARVIS_BACKEND_URL=https://your-backend.onrender.com
